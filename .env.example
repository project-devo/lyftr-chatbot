# Comma-separated Gemini API keys (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Any LiteLLM model name (gemini/gemini-2.0-flash is retired, see README).
LLM_MODEL=gemini/gemini-3.5-flash-lite
# SQLite file; /data is the Docker named volume.
DATABASE_URL=sqlite:////data/app.db
# LiteLLM disk cache directory (also on the volume).
CACHE_DIR=/data/litellm-cache
# Comma-separated CORS origins, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# "true" enables the X-Simulate-Failure request header.
ENABLE_FAILURE_SIMULATION=true
# Used when a session has no system prompt of its own.
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Frontend build-time backend URL.
VITE_API_URL=http://localhost:8000
